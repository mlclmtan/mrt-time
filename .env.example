# MRT Time — every environment variable the code reads.
# Everything is optional: `pnpm build` passes with none set, and each
# integration is a no-op until its variables exist. Never commit real values.

# --- Core ---------------------------------------------------------------
# Public origin, used for metadata/sitemap, QStash callback URLs and email links.
APP_URL=https://mrt.91208274.xyz
# Neon Postgres (pooled) connection string. Without it the app runs on the
# LTA fallback headway model only (no readings, logging, analytics or admin).
DATABASE_URL=
# Salt for the daily IP hash used only for rate limiting (raw IPs are never stored).
IP_HASH_SALT=

# --- Auth (Better Auth + Google, passkeys optional) ---------------------------
BETTER_AUTH_URL=https://mrt.91208274.xyz
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated owner emails (full access). Empty = nobody can sign in.
ALLOWED_EMAILS=
# Optional comma-separated read-only analysts (admin analytics only).
ANALYST_EMAILS=
# Local UI work only: "1" + NODE_ENV=development, refused on Vercel or with DATABASE_URL.
MRT_DEV_BYPASS=

# --- Hermes ingest + cron ------------------------------------------------------
# Bearer token for POST /api/ingest (see docs/ingest-api.md).
INGEST_TOKEN=
# Vercel sends this as a Bearer token to GET /api/cron/sandbox.
CRON_SECRET=

# --- LTA DataMall + data.gov.sg ------------------------------------------------
# Train Service Alerts + Station Crowd Density (free key from datamall.lta.gov.sg).
LTA_ACCOUNT_KEY=
# Optional data.gov.sg key (higher rate limit for the 2-hour forecast).
DATA_GOV_SG_API_KEY=

# --- Web Push + QStash ---------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services.
VAPID_SUBJECT=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Regional QStash origin, e.g. https://qstash-eu-central-1.upstash.io (default global).
QSTASH_URL=

# --- Analytics (production property) ----------------------------------------------
# Google Tag Manager container (preferred). Loaded only after consent.
NEXT_PUBLIC_GTM_ID=
# GA4 measurement id; used directly via gtag when no GTM id is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: production GA4 id when only GTM is used (the sandbox refuses to send to it).
GA_PRODUCTION_MEASUREMENT_ID=
# Optional Google Ads id (AW-…), configured via gtag under marketing consent.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Microsoft Clarity project id (analytics consent; set masking to Strict in Clarity).
NEXT_PUBLIC_CLARITY_ID=
# Meta Pixel (marketing consent) + Conversions API (server, deduped by event_id).
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Events Manager → Test events code (remove in production).
META_TEST_EVENT_CODE=

# --- Practice sandbox (SEPARATE GA4 property, synthetic data only) ------------------
GA_SANDBOX_MEASUREMENT_ID=
GA_SANDBOX_API_SECRET=

# --- Newsletter -------------------------------------------------------------------
# With Resend set, signups get a double opt-in email; without it emails are just stored.
RESEND_API_KEY=
# e.g. "MRT Time <hello@yourdomain>"
NEWSLETTER_FROM=

# --- Read automatically, normally not set by hand ------------------------------------
# NODE_ENV, VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA (Vercel); NEXT_PUBLIC_APP_VERSION,
# NEXT_PUBLIC_BUILD_SHA, NEXT_PUBLIC_BUILT_AT, NEXT_PUBLIC_BUILD_ID are baked in by next.config.ts.
